# .env.example - Copia este archivo a .env y completa los valores
# ⚠️ NUNCA subas .env a GitHub

# Servidor
PORT=3000
WS_PORT=8080
NODE_ENV=development

# 🔑 Claves API (OBLIGATORIAS)
ESP32_API_KEY=tu_clave_de_thingsboard_aqui
JWT_SECRET=tu_api_key_de_render_aqui

# 🌐 URLs (OBLIGATORIAS)
FRONTEND_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000

# ⚙️ Opcionales
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOG_LEVEL=debug